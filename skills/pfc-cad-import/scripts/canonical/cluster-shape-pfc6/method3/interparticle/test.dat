model new 


model domain extent -10 10 

ball generate number 200 radius 0.1 0.5 box -8 8

ball group "small" slot "radius" range radius 0.1 0.2 
ball group "big" slot "radius" range radius  0.2 0.5

ball group "up" slot "posy" range pos-y 0 8 
ball group "down" slot "posy" range pos-y  -8 0

[bp=ball.find(1)]


[gp=ball.group(bp,"radius")]

