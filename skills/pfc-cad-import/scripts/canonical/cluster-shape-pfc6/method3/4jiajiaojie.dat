model restore "re_sample"
contact cmat default type ball-facet model linear property kn 1e7 ks 1e7 
def ApllyGroupToBall
    count=0
    loop foreach rb rblock.list
        count+=1
        rb_id=rblock.id(rb)
        groupName=rblock.group(rb)
        wall_name="nn_"+string(count)
        command
            rblock export to-geometry "rb" range id @rb_id
            wall import group "rb_gro" name @wall_name from-geometry "rb"
            model cycle 2000 calm 20
            ball group @groupName  range geometry-space "rb" inside
            
            geometry delete
            rblock delete range id @rb_id
        endcommand
        
    endloop
end
@ApllyGroupToBall



wall delete walls range group "rb_gro"


contact cmat add 1  model linear method deform emod 1e9 kratio 1.5 property fric 0.5 lin_mode 1  range contact type "ball-facet"

contact cmat add 2 model linearpbond method deform emod 2e9 kratio 1.5 ...
                                pb_deform emod 1e9 kratio 1.5 ...
                                property pb_coh 10e6 pb_ten 10e6 pb_fa 50 fric 0.5 lin_mode 1 range group "changshi" 
contact cmat add 3  model linearpbond method deform emod 3e9 kratio 1.5 ...
                                pb_deform emod 1e9 kratio 1.5 ...
                                property pb_coh 10e6 pb_ten 10e6 pb_fa 50 fric 0.5 lin_mode 1  range group "shiying" 
contact cmat add 4  model linearpbond method deform emod 4e9 kratio 1.5 ...
                                pb_deform emod 1e9 kratio 1.5 ...
                                property pb_coh 10e6 pb_ten 10e6 pb_fa 50 fric 0.5 lin_mode 1  range group "yunmu" 



cmat apply


model clean

model calm
contact method bond gap 0.01
contact property lin_force 0.0 0.0 
ball attribute force-contact multiply 0.0 moment-contact multiply 0.0  

model cycle 1

model solve

model save "jiaojie"