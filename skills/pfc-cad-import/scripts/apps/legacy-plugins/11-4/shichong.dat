       iflag=0 ;;;不收敛 
    end_if
    if abs((wnst15 -sssreg)/sssreg) > sig_tol then
       iflag=0 ;;;不收敛 
    end_if
    if abs((wnst16 -sssreg)/sssreg) > sig_tol then
       iflag=0 ;;;不收敛 
    end_if
    if abs((wnst17 -sssreg)/sssreg) > sig_tol then
       iflag=0 ;;;不收敛 
    end_if
