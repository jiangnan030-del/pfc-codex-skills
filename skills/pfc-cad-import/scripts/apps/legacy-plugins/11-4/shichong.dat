 ;伺服收敛退出
def iterate
     loop while 1 # 0
  get_gain
 iflag=1 ;;;默认收敛
    if abs((wnst1 -sssreg)/sssreg) > sig_tol then
       iflag=0 ;;;不收敛 
    end_if
