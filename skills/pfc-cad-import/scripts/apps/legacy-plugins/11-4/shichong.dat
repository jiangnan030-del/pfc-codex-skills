       iflag=0 ;;;不收敛 
    end_if
    if abs((wnst19 -sssreg)/sssreg) > sig_tol then
       iflag=0 ;;;不收敛 
    end_if
    if abs((wnst20 -sssreg)/sssreg) > sig_tol then
       iflag=0 ;;;不收敛 
    end_if
    if abs((wnst21 -sssreg)/sssreg) > sig_tol then
       iflag=0 ;;;不收敛 
    end_if
    if abs((wnst22 -sssreg)/sssreg) > sig_tol then
       iflag=0 ;;;不收敛 
    end_if
   if iflag = 1 then
        exit
  end_if
    command
      cycle 100
    end_command
  end_loop
end
 set sssreg -1e5 sig_tol 0.001
 iterate ;get all stress to require
save ini_state.sav
