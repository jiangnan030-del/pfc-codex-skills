def assemble_sc
 array mult2(100),mult3(100),mult4(100),mult5(100),mult6(100)
 array mult7(100),mult8(100),mult9(100),mult10(100),mult11(100)
 sum=0.0
 bp=ball_head
 loop while bp # null
  ;if b_id(bp)>= num_begin
  ;if b_id(bp)<= num_end
 sum=sum+pi*b_rad(bp)^2
 ;end_if
 ;end_if
 bp=b_next(bp)
 end_loop
 pmeas=1.0-sum/tot_vol
 mult1=sqrt((1.0-poros)/(1.0-pmeas))
 mult2(mat_flag)=mult1^0.6
 mult3(mat_flag)=mult1^0.2
 mult4(mat_flag)=mult1^0.1
 mult5(mat_flag)=mult1^0.05
 mult6(mat_flag)=mult1^0.05
 end
    
