def get_gain
   alpha = 0.5
;;;x方向
  count = 0
  avg_stiff = 0
  cp = contact_head
  loop while cp # null
  if c_ball1(cp) = wadd1
  count = count + 1
  avg_stiff = avg_stiff + c_kn(cp)
  end_if
  if c_ball2(cp) = wadd1
  count = count + 1
  avg_stiff = avg_stiff + c_kn(cp)
   end_if
  cp = c_next(cp)
  end_loop
   nxcount = count 
    avg_stiff = avg_stiff / count
  gx1= alpha *    3.7361  / (avg_stiff * nxcount * tdel)
  count = 0
  avg_stiff = 0
  cp = contact_head
  loop while cp # null
  if c_ball1(cp) = wadd2
  count = count + 1
