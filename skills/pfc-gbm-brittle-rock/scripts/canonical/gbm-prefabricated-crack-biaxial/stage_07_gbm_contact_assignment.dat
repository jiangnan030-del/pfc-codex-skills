model new
model restore '6' 

ball attribute density 2648 range group 'shiying' 
ball attribute density 2600 range group 'xiechangshi'
ball attribute density 2600 range group 'zhengchangshi' 
ball attribute density 2850 range group 'yunmu'

contact cmat add 1 model linearpbond ...
                 method deform emod 13.8e9 kratio 1 ...
                 pb_deform emod 13.8e9 kratio 1 ...
                 property pb_coh 185.2e6 pb_ten 185.2e6 ...
                 dp_nratio 0.7 pb_fa 45 fric 0.1 ...
                 range group 'shiying' matches 2

contact cmat add 2 model linearpbond ...
                 method deform emod 13.1e9 kratio 1 ...
                 pb_deform emod 13.1e9 kratio 1 ...
                 property pb_coh 205.9e6 pb_ten 205.9e6 ...
                 dp_nratio 0.7 pb_fa 45 fric 0.1 ...
                 range group 'xiechangshi' matches 2

contact cmat add 3 model linearpbond ...
                 method deform emod 8.7e9 kratio 1 ...
                 pb_deform emod 8.7e9 kratio 1 ...
                 property pb_coh 165.9e6 pb_ten 165.9e6 ...
                 dp_nratio 0.7 pb_fa 45 fric 0.1 ...
                 range group 'zhengchangshi' matches 2

contact cmat add 4 model linearpbond ...
                 method deform emod 5.9e9 kratio 1 ...
                 pb_deform emod 5.9e9 kratio 1 ...
                 property pb_coh 150.3e6 pb_ten 150.3e6 ...
                 dp_nratio 0.7 pb_fa 45 fric 0.1 ...
                 range group 'yunmu' matches 2

contact cmat default type ball-ball ...
                 model smoothjoint ...
                 property 'sj_kn' 500e9 'sj_ks' 500e9 ...
                  'sj_fric' 0.1 'sj_ten' 9e6 'sj_fa' 45 ...
                  'sj_coh' 90e6 'sj_large' 1 'sj_state' 3

contact cmat default type ball-facet ...
                    model linear ...
                    method deform emod 13.8e9 kratio 1 ...
                    property fric 0.0
 
contact cmat apply

model clean

contact method bond gap [rmin] range contact type 'ball-ball'
model cycle 1
wall delete walls range id 5
model solve
ball attribute displacement multiply 0.0
contact property lin_force 0.0 0.0 lin_mode 1
ball attribute force-contact multiply 0.0 moment-contact multiply 0.0
model cycle 1
model solve

model save '7'