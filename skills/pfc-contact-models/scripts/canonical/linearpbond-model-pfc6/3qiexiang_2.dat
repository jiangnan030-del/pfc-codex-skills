model restore "faxiang"


ball attribute vel 0.1 0 range id 1


def jiance
    if ct==null then
        exit
    endif
    
    faxiang_force=(-1)*contact.prop(ct,"pb_sigma")*(2*1.0)
    qiexiang_force=contact.prop(ct,"pb_tau")*(2*1.0)
    
    qiexiang_fengzhi=math.tan(50*math.pi/180.0)*faxiang_force+7e5
end

history delete
history id 1 @faxiang_force
history id 2 @qiexiang_force
history id 3 @qiexiang_fengzhi

model mechanical timestep fix 1e-4
model solve time 3

model save "qiexiang2"


