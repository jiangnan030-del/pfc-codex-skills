model restore "sample"

[txx=1e5]
[tyy=1e5]

[mubiao_force_xx=1e5]
[mubiao_force_yy=1e5]

[sevro_factor=1.0]

def wall_init
    wp_down=wall.find(1)
    wp_up=wall.find(3)
    
    wp_left=wall.find(4)
    wp_right=wall.find(2)
end
@wall_init

def Get_zonggang
    zonggang_x=0
    zonggang_y=0
    loop foreach ct wall.contactmap(wp_left)
        zonggang_x=zonggang_x+contact.prop(ct,"kn")
    endloop
    loop foreach ct wall.contactmap(wp_right)
        zonggang_x=zonggang_x+contact.prop(ct,"kn")
    endloop
    
    loop foreach ct wall.contactmap(wp_up)
        zonggang_y=zonggang_y+contact.prop(ct,"kn")
    endloop
    loop foreach ct wall.contactmap(wp_down)
        zonggang_y=zonggang_y+contact.prop(ct,"kn")
    endloop
    
    gx= sevro_factor*wly/(zonggang_x*global.timestep) 
    gy=sevro_factor*wlx/(zonggang_y*global.timestep)
end

def cal_chicun
     wlx=wall.pos.x(wp_right)-wall.pos.x(wp_left)
     wly=wall.pos.y(wp_up)-wall.pos.y(wp_down)
end

def cal_stress
    cal_chicun   
   
    wsxx=(wall.force.contact.x(wp_right)-wall.force.contact.x(wp_left))*0.5/wly
   
    wsyy=(wall.force.contact.y(wp_up)-wall.force.contact.y(wp_down))*0.5/wlx
end

[sevro_freq=100]

[time_record=global.step-sevro_freq-1]

def addVel
    whilestepping    
    cal_stress
    
    if global.step-time_record >sevro_freq then
        Get_zonggang
        time_record=global.step
    endif
    
    
    vel_x=(txx-wsxx)*gx
    vel_y=(tyy-wsyy)*gy  
    
    if txx>wsxx then
        wall.vel.x(wp_left)=math.abs(vel_x)
        wall.vel.x(wp_right)=-math.abs(vel_x)
    else
        wall.vel.x(wp_left)=-math.abs(vel_x)
        wall.vel.x(wp_right)=math.abs(vel_x)
    endif
    
    if tyy>wsyy then
        wall.vel.y(wp_down)=math.abs(vel_y)
        wall.vel.y(wp_up)=-math.abs(vel_y)
    else
        wall.vel.y(wp_down)=-math.abs(vel_y)
        wall.vel.y(wp_up)=math.abs(vel_y)
    endif
    
end

history id 1 @wsxx
history id 2 @wsyy


model cycle 1
model solve 

model save "yuya"
