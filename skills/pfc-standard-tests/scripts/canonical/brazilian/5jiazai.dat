model restore "xiezai"


def addVel
    
end
wall delete

wall create id  1 vertices [-wlr] [wlr] [wlr] [wlr]
wall create id  2 vertices [-wlr] [-wlr] [wlr] [-wlr]

[wp_up=wall.find(1)]
[wp_down=wall.find(2)]


[strainrate=1e-1]

[Iy0=wall.pos.y(wp_up)-wall.pos.y(wp_down)]
[final_strain=1e-2]
wall attribute vel-y [strainrate*Iy0] range id 2
wall attribute vel-y [-strainrate*Iy0] range id 1

def jiance
    whilestepping
    wly=wall.pos.y(wp_up)-wall.pos.y(wp_down)
    weiyi=Iy0-wly
    
    
    force=(wall.force.contact.y(wp_up)-wall.force.contact.y(wp_down))
    wsyy=force/(math.pi*wlr*2.0)
end

program call "fracture.p2fis"
@track_init

history delete

history id 1 @wsyy
history id 2 @weiyi


model solve time [final_strain/strainrate]

model save "result"