model restore "sample"

[trr=1e5]
[sevro_factor=0.1]

def wall_init
    wp_rr=wall.find(1)
end
@wall_init

def Get_zonggang
    cal_chicun
    zonggang_r=0
    wsrr=0
    loop foreach ct wall.contactmap(wp_rr)
        zonggang_r=zonggang_r+contact.prop(ct,"kn")
        wsrr+= math.mag(contact.force.global(ct))
    endloop
    zhouchang=2*math.pi*wlr    
    wsrr=wsrr/zhouchang
    
    if zonggang_r==0 then
        zonggang_r=1e9
    endif
    
    gr= sevro_factor*zhouchang/(zonggang_r*global.timestep) 
end

[wpVert=wall.vertex.find(1)]
def cal_chicun
    wlr= math.mag(wall.vertex.pos(wpVert))
end


[sevro_freq=50]

[time_record=global.step-sevro_freq-1]

def addVel
    whilestepping    
    
    if global.step-time_record >sevro_freq then
        Get_zonggang
        time_record=global.step
        vel_r=(trr-wsrr)*gr
    
        if trr>wsrr then
            loop foreach vt wall.vertexlist(wp_rr)
                pos_normal=math.unit(wall.vertex.pos(vt))
                wall.vertex.vel(vt)=(-1)*pos_normal*math.abs(vel_r)
            endloop
        else
            loop foreach vt wall.vertexlist(wp_rr)
                pos_normal=math.unit(wall.vertex.pos(vt))
                wall.vertex.vel(vt)=pos_normal*math.abs(vel_r)
            endloop
        endif
    endif
    
    
end

history id 1 @wsrr


model cycle 1
model solve 

model save "yuya"