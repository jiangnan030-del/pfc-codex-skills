model restore "sample"
geometry import "11.dxf" 


clump template create bubblepack distance 160 ratio 0.3 ...
            surfcalculate geometry "11"           
            

def tihuan
    loop foreach bp ball.list
        rd=ball.radius(bp)
        if rd<0.02 then
            continue
        endif
        posX=ball.pos.x(bp)
        posY=ball.pos.y(bp)       
        
        ag=math.random.uniform*360
        command
            clump replicate name "11" position  @posX @posY  diameter [rd*2.0] angle @ag
        endcommand
        
        ball.delete(bp)
    endloop
end
@tihuan
clump attribute density 3e3 damp 0.7
model cycle 1
model solve

model save "tihuan"