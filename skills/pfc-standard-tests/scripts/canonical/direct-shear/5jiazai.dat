model restore "weiya"
[strainrate=1e-1]
[final_strain=2e-2]
wall attribute vel-x [strainrate*width] range id 1
wall attribute vel-x [strainrate*width] range id 2
wall attribute vel-x [strainrate*width] range id 3



def jiance
    whilestepping
    weiyi=wall.disp.x(wp_up)
    force=0
    loop n(1,3)
        wp_temp=wall.find(n)
        force+=wall.force.contact.x(wp_temp)
    endloop
    jianyingli=force/width
end
program call "fracture.p2fis"
@track_init

history delete

history id 1 @jianyingli
history id 2 @weiyi

model solve time [final_strain/strainrate]

model save "result"