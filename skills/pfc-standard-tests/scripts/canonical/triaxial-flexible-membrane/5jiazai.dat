model restore "rouxing"

def addVel  
    
end

[strainrate=1e-1]

[final_strain=2e-2]
wall attribute vel-z [strainrate*wlz] range id 2
wall attribute vel-z [-strainrate*wlz] range id 1

[Iz0=wlz]
def jiance
    whilestepping
    wlz=wall.pos.z(wp_up)-wall.pos.z(wp_down)
    wezz=(wlz-Iz0)/Iz0
    wszz=(wall.force.contact.z(wp_up)-wall.force.contact.z(wp_down))*0.5/(math.pi*wlr*wlr)
end

program call "fracture.p3fis"
@track_init

history delete
history id 1 @wszz
history id 2 @wezz

model solve time [final_strain/strainrate]

model save "result"