new
domain extent -10 10
wall generate ...
    group polygons ...
    polygon ...
        -1 -1  0 ...
        1 -1 0 ...
        2 1 0 ...
        1 2 0 ...
        -2 2 0

;坐标点可乱序
wall generate ...
    group polygons ...
    polygon ...
        -1 -1 -1 ...
        1 -1 -1 ...
        1 2 -1 ...
        2 1 -1 ...
        -2 2 -1

pause key

wall generate ...
    group polygons ...
    polygon ...
        -1 -1 0 ...
        1 -1 0 ...
        2 1 1 ...
        2 2 2 ...
        1 2 1 ...
        -2 1 2 ...
        -2 0 1 ...
        makeplanar

pause key

wall generate ...
    group polygons ...
    polygon ...
        -1 -1 0 ...
        1 -1 0 ...
        2 1 3 ...
        2 2 1 ...
        1 2 1 ...
        -2 1 1 ...
        -2 0 1 ...
        makeplanar
