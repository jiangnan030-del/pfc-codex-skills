new
domain extent -10 10

;生成1个wall，7面facets
wall create ...
    group lines ...
    id 2 ...
    name line2 ...
    vertices ...
    -10 -5 ...
    -5 -5 ...
    -5 -5 ...
    0 0 ...
    0 0 ...
    0 5 ...
    0 5 ...
    5 5 ...
    5 5 ...
    2 0 ...
    2 0 ...
    5 -5 ...
    5 -5 ...
    10 0
    
;pause key
;
;wall delete facets range id 2 3

;pause key

;wall delete range id 2 3 by facet

;pause key

;wall delete walls range id 2

;pause key

;wall delete range id 2 by wall

pause key

wall delete facets range y -10 -3   ;坐标范围删除墙体，判断墙体形心位置

pause key

wall delete walls range x -5 10