model restore "clump_template"


model domain extent -5 5

;clump replicate name "11" position  0 0  diameter 0.8 


;clump generate  number 10 size 0.8 2.0 diameter

clump distribute porosity 0.12 diameter size 0.8 2.0 box -4 4
clump attribute density 3e3 damp 0.7
wall generate box -4 4 

cmat default type pebble-pebble model linear property kn 1e7 ks 1e7
cmat default type pebble-Facet model linear property kn 1e8 ks 1e7
model cycle 2000 calm 50
model solve
