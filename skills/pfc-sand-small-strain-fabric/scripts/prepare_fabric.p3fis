; prepare_fabric.p3fis
; Sample clump major-axis directions for Ani I/II/III.
; Verify clump orientation intrinsics for the target PFC release.

fish define fabric_setup
    global ani_level = 1
    global kappa_ani2 = 4.0
    global kappa_ani3 = 12.0
    global fabric_ad = 0.0
    global mechanical_z = 0.0
end
[fabric_setup]

fish define uniform_axis
    local u = 2.0*math.random.uniform-1.0
    local p = 2.0*math.pi*math.random.uniform
    local s = math.sqrt(1.0-u*u)
    uniform_axis = vector(s*math.cos(p),s*math.sin(p),u)
end

; Concentrate axes near the x-y depositional plane by rejection sampling.
fish define planar_axis(kappa)
    local ok = false
    loop while ok = false
        local v = uniform_axis
        if math.random.uniform <= math.exp(-kappa*comp.z(v)^2) then
            planar_axis = v
            ok = true
        endif
    endloop
end

fish define requested_axis
    if ani_level = 1 then
        requested_axis = uniform_axis
    else if ani_level = 2 then
        requested_axis = planar_axis(kappa_ani2)
    else
        requested_axis = planar_axis(kappa_ani3)
    endif
end

fish define assign_fabric
    loop foreach local cp clump.list
        local v = requested_axis
        clump.extra(cp,1)=comp.x(v)
        clump.extra(cp,2)=comp.y(v)
        clump.extra(cp,3)=comp.z(v)
        ; Rotate local +z major axis to v with the documented Euler/quaternion API.
    endloop
end

; Post-compaction acceptance metrics:
; Rij = mean(n_i*n_j)
; aij = 7.5*(Rij-deltaij/3)
; ad  = sqrt(1.5*sum(aij*aij))
; Zm  = (2*Nc-N1)/(Np-N1-N0), counted per physical clump/grain.
;
; Export clump.extra(1..3), random seed and normalization rule. Tune kappa to
; target ad values in references/fabric-metrics.md, not visual appearance only.
