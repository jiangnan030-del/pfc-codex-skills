; cyclic_small_strain.p3fis
; Small-amplitude cyclic triaxial skeleton: axial strain control plus
; constant-volume lateral control. Verify wall APIs for the target PFC version.

fish define setup
    global eps_amp = 3.0e-6
    global freq_hz = 5.0
    global n_loop = 1
    global target_pressure = 100.0e3 ; configurable; do not infer from paper
    global t0 = mech.time.total
    global period = 1.0/freq_hz
    global eps_ax = 0.0
    global eps_lat = 0.0
    global eps_vol = 0.0
    global sig_dev = 0.0
    global mean_p = 0.0
    global loop_done = false
end
[setup]

; Save initial dimensions after isotropic consolidation.
fish define capture_reference
    global lx0 = wall.pos.x(wall.find('xmax'))-wall.pos.x(wall.find('xmin'))
    global ly0 = wall.pos.y(wall.find('ymax'))-wall.pos.y(wall.find('ymin'))
    global lz0 = wall.pos.z(wall.find('zmax'))-wall.pos.z(wall.find('zmin'))
end

fish define update_state
    local lx = wall.pos.x(wall.find('xmax'))-wall.pos.x(wall.find('xmin'))
    local ly = wall.pos.y(wall.find('ymax'))-wall.pos.y(wall.find('ymin'))
    local lz = wall.pos.z(wall.find('zmax'))-wall.pos.z(wall.find('zmin'))
    eps_ax = (lz-lz0)/lz0
    eps_lat = 0.5*((lx-lx0)/lx0+(ly-ly0)/ly0)
    eps_vol = eps_ax+2.0*eps_lat
    ; Calculate principal stresses from opposing wall reactions/areas.
    ; sig_dev = sigma_z-0.5*(sigma_x+sigma_y)
    ; mean_p = (sigma_x+sigma_y+sigma_z)/3.0
end

fish define cyclic_target
    local t = mech.time.total-t0
    cyclic_target = eps_amp*math.sin(2.0*math.pi*freq_hz*t)
end

fish define cyclic_servo
    update_state
    local target = cyclic_target
    ; Set top/bottom wall velocities from (target-eps_ax).
    ; Set x/y wall velocities so eps_vol -> 0.
    ; Do not impose constant pressure on the same lateral DOFs simultaneously.
end

fish define stop_after_loop
    local elapsed = mech.time.total-t0
    stop_after_loop = false
    if elapsed >= n_loop*period then
        stop_after_loop = true
        loop_done = true
    endif
end

history interval 10
fish history name 'eps_ax' @eps_ax
fish history name 'eps_lat' @eps_lat
fish history name 'eps_vol' @eps_vol
fish history name 'sig_dev' @sig_dev
fish history name 'mean_p' @mean_p

; Usage after consolidation/rotation:
; [capture_reference]
; fish callback add @cyclic_servo -1.0
; model solve fish-halt @stop_after_loop
; model save 'cyclic_done'
;
; Confirm quasi-static behavior from kinetic/strain-energy ratio, pressure drift
; and volume-strain residual. Scan lower amplitudes to demonstrate a G0 plateau.
