new

;生成并记录数据
def record_data
    array arr(100)
    
    loop row(1,10)
        arr_str = ''
        loop col(1,5)
            arr_str = arr_str + ' ' + string(row * math.random.uniform)
        endloop
        arr(row) = arr_str
    endloop
    max_i = row - 1
end
@record_data

;输出数据
def output_data
    loop datafile_num(1,3)
        file_name = 'data_1' + string(datafile_num) + '.dat'
        status = file.open(file_name, 1, 1)
        status = file.write(arr,max_i)
        status = file.close()
    endloop
end
@output_data