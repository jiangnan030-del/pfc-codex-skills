new

;读入数据
def read_data
    array arr(100) var(100,100)
    
    max_i = 5
    max_j = 7
    
    datafile_num = 1
    file_name = 'data_1' + string(datafile_num) + '.dat'
    status = file.open(file_name, 0, 1)
    status = file.read(arr,max_i)
    status = file.close()
    
    ;arr(1) arr(5)
    string_len = string.len(arr(1)) 
    
    ;拆分字符串
    loop _i(1,max_i)
        loop _j(1,max_j)
            var(_i,_j) = string.token(arr(_i),_j)
            ir = string.token.type(arr(_i),_j)
            
            command
                list @ir
                pause key
            endcommand
        endloop
    endloop
end
@read_data

;输出数据
def output_data
    datafile_num = 2
    file_name = 'data_01' + string(datafile_num) + '.dat'
    status = file.open(file_name, 1, 1)
    status = file.write(arr,max_i)
    status = file.close()
    
    datafile_num = 3
    file_name = 'data_01' + string(datafile_num) + '.dat'
    status = file.open(file_name, 1, 1)
    status = file.write(var,max_i) ;var(_i,1) _i=1...5
    status = file.close()
    
    loop local m (1,max_i)
        local hed = '   '
        local msg = '  '+string(m)
        loop local n (1,max_j)
            hed = hed + '               '+string(n)
            msg = msg + '  '+string(var(m,n),8,' ',8,'E')
        end_loop
        if m = 1
            io.out(hed)
        end_if
        io.out(msg)
    end_loop
end
@output_data