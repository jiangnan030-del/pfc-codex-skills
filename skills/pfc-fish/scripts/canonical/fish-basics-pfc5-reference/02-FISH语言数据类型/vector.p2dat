new
def vector_test
    vec1 = vector(1,2,3)
    vec2 = vector(4,5,6)
    
    vec1_comp1 = comp.x(vec1)
    vec1_comp2 = comp.y(vec1)
    vec1_comp3 = comp.z(vec1)
    
    vec3 = vec1 + vec2
    
    vec3_comp1 = comp(vec3,1)
    vec3_comp2 = comp(vec3,2)
    vec3_comp3 = comp(vec3,3)
    
    vec4 = vec1 * vec2 * 2
    
    vec4_comp1 = comp(vec4,1)
    vec4_comp2 = comp(vec4,2)
    vec4_comp3 = comp(vec4,3)
    
    vec5 = vec1/2.0
    
    vec5_comp1 = comp(vec5,1)
    vec5_comp2 = comp(vec5,2)
    vec5_comp3 = comp(vec5,3)
end
@vector_test
list @vec1_comp1 @vec1_comp2 @vec1_comp3
list @vec3_comp1 @vec3_comp2 @vec3_comp3
list @vec4_comp1 @vec4_comp2 @vec4_comp3
list @vec5_comp1 @vec5_comp2 @vec5_comp3