new
def sum0
    section
        count = count * 1.5
        if count >= 13 then
            exit section
        endif
    endsection
end

def sum
    count = 0
    sum = 0
    _i = 0
    section
        loop while 1 # 0
            _i = _i + 1
            count = count + _i
            if count >= 7 then
                exit section
            endif
            if _i >=5 then
                ;exit loop
                exit section
            else
                continue
            endif
            ;sum0
            count = count - 1
        endloop
    endsection
    sum = count
end
list @sum